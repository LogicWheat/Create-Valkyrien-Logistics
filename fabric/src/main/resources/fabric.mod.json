{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "{$mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "${homepage}",
    "sources": "${sources}"
  },
  "license": "${mod_license}",
  "icon": "assets/${mod_id}/logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "io.github.techtastic.valkyrien_logistics.fabric.ValkyrienLogisticsFabric"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "io.github.techtastic.valkyrien_logistics.fabric.ValkyrienLogisticsFabric${'$'}Client"
      }
    ],
    "preLaunch": [
      {
        "adapter": "kotlin",
        "value": "io.github.techtastic.valkyrien_logistics.fabric.ValkyrienPreLaunch"
      }
    ]
  },
  "mixins": [
    "valkyrien_logistics-common.mixins.json",
    "valkyrien_logistics.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_version}",
    "valkyrienskies": ">=2.4.0",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "architectury": ">=${architectury_version}",
    "create": ">=6.0.7",
    "extra_gauges": ">=2.0.5"
  }
}